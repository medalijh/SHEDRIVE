{
  "name": "SheDrive Morocco",
  "short_name": "SheDrive",
  "description": "Transport exclusivement féminin au Maroc — Sûr, Élégant, Empowerant 🌹",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#1A150F",
  "theme_color": "#C8956C",
