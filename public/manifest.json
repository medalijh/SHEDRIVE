  "shortcuts": [
    {
      "name": "Réserver un trajet",
      "short_name": "Réserver",
      "description": "Réservez un trajet maintenant",
      "url": "/passenger/book",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Tableau de bord conductrice",
      "short_name": "Conduire",
      "description": "Accédez au tableau de bord conductrice",
      "url": "/driver/dashboard",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Mon portefeuille",
      "short_name": "Wallet",
      "description": "Consultez votre solde",
      "url": "/passenger/wallet",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/passenger-dashboard.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tableau de bord passagère"
    },
    {
      "src": "/screenshots/booking.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Réserver un trajet"
    },
    {
      "src": "/screenshots/driver-dashboard.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tableau de bord conductrice"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "protocol_handlers": [
    { "protocol": "web+shedrive", "url": "/?action=%s" }
  ],
  "share_target": {
    "action": "/passenger/book",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [],
  "handle_links": "preferred"
}
